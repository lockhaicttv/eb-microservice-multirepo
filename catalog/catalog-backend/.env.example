# --- catalog-backend -----------------------------------------------------
# Copy to .env and adjust. Loaded by ConfigModule at runtime and by dotenv
# in the `typeorm` CLI scripts.

# Postgres connection. Matches the docker-compose service; the `catalog`
# database is created on first container boot.
DATABASE_URL=postgres://demo:demo123@localhost:5432/catalog

# Run pending migrations automatically on boot. Off by default: prefer the
# explicit `npm run migration:run`.
DB_MIGRATIONS_RUN=false

# Escape hatch: let TypeORM rewrite the schema from entity metadata.
# Only for throwaway local experiments. Never enable against real data.
DB_SYNCHRONIZE=false

# Log every SQL statement to stdout.
DB_LOGGING=false

# --- service ------------------------------------------------------------
GRPC_URL=0.0.0.0:5102

# auth-backend is queried to re-validate the caller's token on owner-scoped
# RPCs (CreateProduct / ListOwnerProducts). This service does not trust the
# BFF's role check.
AUTH_GRPC_URL=localhost:5101
